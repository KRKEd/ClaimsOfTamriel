@prefix : <http://www.semanticweb.org/skyrim/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix schema: <https://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://www.semanticweb.org/skyrim/ontology#> .

<http://www.semanticweb.org/skyrim/ontology> rdf:type owl:Ontology ;
    dc:title "Claims of Tamriel" ;
    dc:creator "Atakan Kayi" ;
    dc:description "An OWL ontology modelling conflicting claims, perspectives, and narratives within the Elder Scrolls V: Skyrim universe. v5.0 adds OWL restrictions, disjoint classes, property characteristics, a property chain axiom, FOAF/PROV-O/Schema.org alignment, and a SKOS ClaimType concept scheme." ;
    owl:versionInfo "5.0" .

#################################################################
# Annotation Properties
#################################################################

dc:title rdf:type owl:AnnotationProperty .
dc:creator rdf:type owl:AnnotationProperty .
dc:description rdf:type owl:AnnotationProperty .
schema:url rdf:type owl:AnnotationProperty .
foaf:name rdf:type owl:AnnotationProperty .
skos:prefLabel rdf:type owl:AnnotationProperty .
skos:definition rdf:type owl:AnnotationProperty .
skos:broader rdf:type owl:AnnotationProperty .
skos:narrower rdf:type owl:AnnotationProperty .
skos:inScheme rdf:type owl:AnnotationProperty .
skos:related rdf:type owl:AnnotationProperty .

#################################################################
# Classes
#################################################################

:City rdf:type owl:Class ;
    rdfs:subClassOf schema:Place ;
    rdfs:label "City" ;
    rdfs:comment "A major settlement or hold capital in Skyrim. Aligned with schema:Place." .

:Race rdf:type owl:Class ;
    rdfs:label "Race" ;
    rdfs:comment "A playable race or notable creature type in the Elder Scrolls universe." .

:Character rdf:type owl:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :belongsToRace ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :Race
    ] ;
    rdfs:label "Character" ;
    rdfs:comment "A named NPC or protagonist. Aligned with foaf:Person. Each Character belongs to at least one Race (owl:minQualifiedCardinality 1) and may belong to multiple races to support mixed heritage." .

:Item rdf:type owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A significant artifact whose ownership, meaning, or legitimacy is contested." .

:Faction rdf:type owl:Class ;
    rdfs:subClassOf foaf:Group ;
    rdfs:label "Faction" ;
    rdfs:comment "A political, military, religious, or social group. Aligned with foaf:Group." .

:ClaimType rdf:type owl:Class ;
    rdfs:label "Claim Type" ;
    rdfs:comment "A controlled vocabulary category for classifying claims." .

:Claim rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasClaimHolder ;
        owl:someValuesFrom :Character
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasClaimTypeIRI ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :ClaimType
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasDescription ;
        owl:someValuesFrom xsd:string
    ] ;
    rdfs:label "Claim" ;
    rdfs:comment "A reified proposition aligned with prov:Entity. Restrictions enforce: every Claim has (1) at least one Character holder, (2) exactly one ClaimType, (3) a description string." .

#################################################################
# Disjoint Classes
#################################################################

[] rdf:type owl:AllDisjointClasses ;
    owl:members ( :Character :Faction :City :Race :Item :Claim :ClaimType ) .

#################################################################
# Object Properties
#################################################################

:belongsToRace rdf:type owl:ObjectProperty ;
    rdfs:domain :Character ;
    rdfs:range :Race ;
    rdfs:label "belongs to race" .

:memberOf rdf:type owl:ObjectProperty ;
    rdfs:domain :Character ;
    rdfs:range :Faction ;
    rdfs:label "member of" .

:hasClaimHolder rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:domain :Claim ;
    rdfs:range :Character ;
    rdfs:label "has claim holder" ;
    rdfs:comment "Sub-property of prov:wasAttributedTo: a claim is attributed to its holder." .

:hasClaimTypeIRI rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Claim ;
    rdfs:range :ClaimType ;
    rdfs:label "has claim type IRI" ;
    rdfs:comment "owl:FunctionalProperty: each Claim has exactly one ClaimType." .

:framesAs rdf:type owl:ObjectProperty ;
    rdfs:domain :Character ;
    rdfs:range :Claim ;
    owl:inverseOf :isFramedBy ;
    rdfs:label "frames as" .

:isFramedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Claim ;
    rdfs:range :Character ;
    owl:inverseOf :framesAs ;
    rdfs:label "is framed by" .

:contradicts rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain :Claim ;
    rdfs:range :Claim ;
    rdfs:label "contradicts" ;
    rdfs:comment "Symmetric. Logical opposition: if A contradicts B then B contradicts A." .

:denies rdf:type owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:domain :Claim ;
    rdfs:range :Claim ;
    rdfs:label "denies" ;
    rdfs:comment "Directional. owl:IrreflexiveProperty: a claim cannot deny itself." .

:disputes rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain :Claim ;
    rdfs:range :Claim ;
    rdfs:label "disputes" ;
    rdfs:comment "Symmetric. Interpretive difference without strict logical contradiction." .

:relatesTo rdf:type owl:ObjectProperty ;
    rdfs:label "relates to" .

:hasTarget rdf:type owl:ObjectProperty ;
    rdfs:domain :Claim ;
    rdfs:range owl:Thing ;
    rdfs:label "has target" .

:hasEvidence rdf:type owl:ObjectProperty ;
    rdfs:domain :Claim ;
    rdfs:range owl:Thing ;
    rdfs:label "has evidence" .

:hasSource rdf:type owl:ObjectProperty ;
    rdfs:domain :Claim ;
    rdfs:range :Faction ;
    rdfs:label "has source" ;
    rdfs:comment "Links a Claim to the Faction that collectively backs or endorses it. Distinct from :sourceURL (data property for external web links) and :hasClaimHolder (individual Character who holds the claim)." .

:hasOpposingHolder rdf:type owl:ObjectProperty ;
    rdfs:domain :Claim ;
    rdfs:range :Character ;
    rdfs:label "has opposing holder" ;
    rdfs:comment "Inferred via property chain: :contradicts o :hasClaimHolder. Links a claim to the holder of any claim it contradicts. No direct assertions needed — the reasoner derives this automatically." ;
    owl:propertyChainAxiom ( :contradicts :hasClaimHolder ) .

#################################################################
# Data Properties
#################################################################

:hasID rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "has ID" .

:hasRole rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "has role" .

:hasLocation rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "has location" .

:hasAffiliationLabel rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "has affiliation label" .

:hasTrait rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "has trait" .

:hasDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain :Claim ;
    rdfs:range xsd:string ;
    rdfs:label "has description" .

:hasClaimType rdf:type owl:DatatypeProperty ;
    rdfs:domain :Claim ;
    rdfs:range xsd:string ;
    rdfs:label "has claim type" .

:sourceURL rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:anyURI ;
    rdfs:label "source URL" .

:hasEvidenceStrength rdf:type owl:DatatypeProperty ;
    rdfs:domain :Claim ;
    rdfs:range xsd:decimal ;
    rdfs:label "has evidence strength" ;
    rdfs:comment "0.0-1.0 score representing relative strength of evidence supporting this claim." .

#################################################################
# SKOS Concept Scheme
#################################################################

:ClaimTypeScheme rdf:type skos:ConceptScheme ;
    skos:prefLabel "Claims of Tamriel ClaimType Vocabulary"@en ;
    rdfs:comment "SKOS concept scheme organizing 11 ClaimType individuals. Counter-claim types are skos:narrower than their primary counterparts." .

#################################################################
# ClaimType Individuals (with SKOS)
#################################################################

:TerritorialClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Territorial Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Territorial Claim"@en ;
    skos:narrower :SovereigntyClaim ;
    rdfs:comment "A claim over land, territory, or settlement." .

:SovereigntyClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Sovereignty Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Sovereignty Claim"@en ;
    skos:broader :TerritorialClaim ;
    rdfs:comment "Legitimate political governance over a region. Narrower than TerritorialClaim." .

:TheologicalClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Theological Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Theological Claim"@en ;
    skos:narrower :TheologicalCounterClaim ;
    skos:narrower :TheologicalMoralClaim ;
    rdfs:comment "Divine status or religious legitimacy." .

:TheologicalCounterClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Theological Counter-Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Theological Counter-Claim"@en ;
    skos:broader :TheologicalClaim ;
    rdfs:comment "Denies the theological legitimacy of a corresponding Theological Claim." .

:PoliticalClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Political Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Political Claim"@en ;
    skos:narrower :PoliticalCounterClaim ;
    rdfs:comment "Political motivation or actor legitimacy." .

:PoliticalCounterClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Political Counter-Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Political Counter-Claim"@en ;
    skos:broader :PoliticalClaim ;
    rdfs:comment "Contests a political actor's stated motivations." .

:MoralClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Moral Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Moral Claim"@en ;
    skos:narrower :MoralCounterClaim ;
    rdfs:comment "Normative claim about justice, punishment, or redemption." .

:MoralCounterClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Moral Counter-Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Moral Counter-Claim"@en ;
    skos:broader :MoralClaim ;
    rdfs:comment "Rejects or complicates a Moral Claim." .

:CosmologicalClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Cosmological Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Cosmological Claim"@en ;
    skos:narrower :CosmologicalCounterClaim ;
    rdfs:comment "Nature or fate of cosmic forces." .

:CosmologicalCounterClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Cosmological Counter-Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Cosmological Counter-Claim"@en ;
    skos:broader :CosmologicalClaim ;
    rdfs:comment "Rejects or reframes a cosmological assertion." .

:TheologicalMoralClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Theological-Moral Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Theological-Moral Claim"@en ;
    skos:broader :TheologicalClaim ;
    skos:related :MoralClaim ;
    rdfs:comment "Blends theological framing with moral judgment. skos:related to MoralClaim." .

:SupremacistClaim rdf:type owl:NamedIndividual , :ClaimType ;
    rdfs:label "Supremacist Claim" ;
    skos:inScheme :ClaimTypeScheme ;
    skos:prefLabel "Supremacist Claim"@en ;
    rdfs:comment "Inherent dominance or superiority of one group." .

