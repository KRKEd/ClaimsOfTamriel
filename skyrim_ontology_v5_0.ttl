    :belongsToRace :Nord ;
    foaf:name "Balgruuf the Greater" ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Balgruuf_the_Greater"^^xsd:anyURI ;
    rdfs:comment "No framesAs assertions — neutrality encoded as structured absence. FILTER NOT EXISTS returns only this character." .

