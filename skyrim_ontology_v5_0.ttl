:CLM_A001 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Skyrim belongs to the Nords" ;
    :hasID "CLM-A001" ; :hasClaimType "Territorial Claim" ;
    :hasClaimTypeIRI :TerritorialClaim ;
    :hasDescription "Skyrim belongs to the Nords — it is their land by blood, history, and rightful inheritance." ;
    :hasEvidenceStrength "0.60"^^xsd:decimal ;
    :hasClaimHolder :Ulfric_Stormcloak ;
    :hasTarget :Windhelm ;
    :hasEvidence :Jagged_Crown ; :hasEvidence :Talos_Tradition ;
    :hasSource :Stormcloaks ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Civil_War"^^xsd:anyURI ;
    :contradicts :CLM_B001 ;
    :relatesTo :Windhelm ; :relatesTo :Whiterun ; :relatesTo :Dunmer ; :relatesTo :Khajiit .

:CLM_B001 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Skyrim is an Imperial province" ;
    :hasID "CLM-B001" ; :hasClaimType "Sovereignty Claim" ;
    :hasClaimTypeIRI :SovereigntyClaim ;
    :hasDescription "Skyrim is a province of the Empire; its stability and protection depend on remaining part of it." ;
    :hasEvidenceStrength "0.70"^^xsd:decimal ;
    :hasClaimHolder :General_Tullius ;
    :hasTarget :Solitude ;
    :hasEvidence :White_Gold_Concordat ;
    :hasSource :Imperial_Legion ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Civil_War"^^xsd:anyURI ;
    :contradicts :CLM_A001 ;
    :relatesTo :Solitude ; :relatesTo :Whiterun .

:CLM_A002 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Talos is the 9th Divine" ;
    :hasID "CLM-A002" ; :hasClaimType "Theological Claim" ;
    :hasClaimTypeIRI :TheologicalClaim ;
    :hasDescription "Tiber Septim achieved divinity after death and is rightfully worshipped as Talos, the 9th Divine." ;
    :hasEvidenceStrength "0.55"^^xsd:decimal ;
    :hasClaimHolder :Ulfric_Stormcloak ;
    :hasTarget :Talos_Tradition ; :hasEvidence :Talos_Tradition ;
    :hasSource :Stormcloaks ;
    :sourceURL "https://en.uesp.net/wiki/Lore:Talos"^^xsd:anyURI ;
    :contradicts :CLM_B002 ; :denies :CLM_B002 ;
    :relatesTo :Nord ; :relatesTo :Solitude .

:CLM_B002 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Talos was mortal — his worship is heresy" ;
    :hasID "CLM-B002" ; :hasClaimType "Theological Counter-Claim" ;
    :hasClaimTypeIRI :TheologicalCounterClaim ;
    :hasDescription "Talos was a mortal man who never achieved divinity; worshipping him is heresy under the White-Gold Concordat." ;
    :hasEvidenceStrength "0.65"^^xsd:decimal ;
    :hasClaimHolder :Elenwen ;
    :hasTarget :Talos_Tradition ; :hasEvidence :White_Gold_Concordat ;
    :hasSource :Thalmor ;
    :sourceURL "https://en.uesp.net/wiki/Lore:White-Gold_Concordat"^^xsd:anyURI ;
    :contradicts :CLM_A002 ; :denies :CLM_A002 ;
    :relatesTo :Nord ; :relatesTo :Solitude .

:CLM_A003 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Ulfric is a genuine freedom fighter" ;
    :hasID "CLM-A003" ; :hasClaimType "Political Claim" ;
    :hasClaimTypeIRI :PoliticalClaim ;
    :hasDescription "Ulfric Stormcloak is a genuine freedom fighter seeking Nord cultural and political independence." ;
    :hasEvidenceStrength "0.40"^^xsd:decimal ;
    :hasClaimHolder :Ulfric_Stormcloak ;
    :hasTarget :Ulfric_Stormcloak ;
    :hasSource :Stormcloaks ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Ulfric_Stormcloak"^^xsd:anyURI ;
    :contradicts :CLM_B003 ;
    :relatesTo :Ulfric_Stormcloak ; :relatesTo :Windhelm .

:CLM_B003 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Ulfric is an unwitting Thalmor asset" ;
    :hasID "CLM-B003" ; :hasClaimType "Political Counter-Claim" ;
    :hasClaimTypeIRI :PoliticalCounterClaim ;
    :hasDescription "Ulfric is an unwitting Thalmor asset — his rebellion keeps the Empire fractured, serving Aldmeri Dominion interests." ;
    :hasEvidenceStrength "0.85"^^xsd:decimal ;
    :hasClaimHolder :Elenwen ;
    :hasTarget :Ulfric_Stormcloak ; :hasEvidence :Thalmor_Dossier_Ulfric ;
    :hasSource :Thalmor ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Dossier:_Ulfric_Stormcloak"^^xsd:anyURI ;
    :contradicts :CLM_A003 ;
    :relatesTo :Ulfric_Stormcloak ; :relatesTo :Windhelm .

:CLM_A004 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Paarthurnax must be executed for his crimes" ;
    :hasID "CLM-A004" ; :hasClaimType "Moral Claim" ;
    :hasClaimTypeIRI :MoralClaim ;
    :hasDescription "Paarthurnax committed unforgivable atrocities while serving Alduin and must face justice regardless of his later deeds." ;
    :hasEvidenceStrength "0.50"^^xsd:decimal ;
    :hasClaimHolder :Delphine ;
    :hasTarget :Paarthurnax ;
    :hasSource :Blades_Faction ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Paarthurnax_(quest)"^^xsd:anyURI ;
    :contradicts :CLM_B004 ;
    :relatesTo :Paarthurnax .

:CLM_B004 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Paarthurnax has earned redemption" ;
    :hasID "CLM-B004" ; :hasClaimType "Moral Counter-Claim" ;
    :hasClaimTypeIRI :MoralCounterClaim ;
    :hasDescription "Paarthurnax has spent millennia atoning for past crimes by guiding humanity; his redemption is real and he deserves to live." ;
    :hasEvidenceStrength "0.70"^^xsd:decimal ;
    :hasClaimHolder :Paarthurnax ;
    :hasTarget :Paarthurnax ;
    :hasSource :Greybeards_Faction ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Paarthurnax"^^xsd:anyURI ;
    :contradicts :CLM_A004 ;
    :relatesTo :Paarthurnax .

:CLM_A005 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "The werewolf form is Hircine's gift" ;
    :hasID "CLM-A005" ; :hasClaimType "Theological-Moral Claim" ;
    :hasClaimTypeIRI :TheologicalMoralClaim ;
    :hasDescription "Lycanthropy is Hircine's gift: it grants power, freedom, and belonging to the Great Hunt." ;
    :hasEvidenceStrength "0.45"^^xsd:decimal ;
    :hasClaimHolder :Hircine ;
    :hasTarget :Werewolf ;
    :sourceURL "https://en.uesp.net/wiki/Lore:Hircine"^^xsd:anyURI ;
    :disputes :CLM_B005 ;
    :relatesTo :Werewolf .

:CLM_B005 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "The werewolf form is a burden and a curse" ;
    :hasID "CLM-B005" ; :hasClaimType "Moral Counter-Claim" ;
    :hasClaimTypeIRI :MoralCounterClaim ;
    :hasDescription "The werewolf curse is a burden: it denies Sovngarde, prevents rest, and traps the soul in Hircine's Hunting Grounds on death." ;
    :hasEvidenceStrength "0.75"^^xsd:decimal ;
    :hasClaimHolder :Dragonborn ;
    :hasTarget :Werewolf ; :hasEvidence :Kodlak_Testament ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Werewolf"^^xsd:anyURI ;
    :disputes :CLM_A005 ;
    :relatesTo :Werewolf .

:CLM_A006 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Alduin is the World-Eater — prophesied end of the age" ;
    :hasID "CLM-A006" ; :hasClaimType "Cosmological Claim" ;
    :hasClaimTypeIRI :CosmologicalClaim ;
    :hasDescription "Alduin's return fulfills the ancient prophecy — he is the World-Eater and the end of the current age." ;
    :hasEvidenceStrength "0.50"^^xsd:decimal ;
    :hasClaimHolder :Alduin ;
    :hasTarget :Alduin ; :hasEvidence :Elder_Scroll ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Alduin"^^xsd:anyURI ;
    :disputes :CLM_B006 ;
    :relatesTo :Alduin ; :relatesTo :Elder_Scroll .

:CLM_B006 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Alduin is a powerful dragon, not a cosmic inevitability" ;
    :hasID "CLM-B006" ; :hasClaimType "Cosmological Counter-Claim" ;
    :hasClaimTypeIRI :CosmologicalCounterClaim ;
    :hasDescription "Alduin is an extraordinarily powerful dragon, but not a cosmic inevitability — he can and must be defeated." ;
    :hasEvidenceStrength "0.80"^^xsd:decimal ;
    :hasClaimHolder :Dragonborn ;
    :hasTarget :Alduin ;
    :hasEvidence :Dragonrend_Shout ; :hasEvidence :Elder_Scroll ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Dragonrend"^^xsd:anyURI ;
    :disputes :CLM_A006 ;
    :relatesTo :Alduin ; :relatesTo :Elder_Scroll .

:CLM_A007 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "The Reach is Reachmen land stolen by Nord conquest" ;
    :hasID "CLM-A007" ; :hasClaimType "Territorial Claim" ;
    :hasClaimTypeIRI :TerritorialClaim ;
    :hasDescription "Markarth and The Reach are the ancestral homeland of the Reachmen; violently seized by Nord conquerors and remain occupied territory." ;
    :hasEvidenceStrength "0.65"^^xsd:decimal ;
    :hasClaimHolder :Madanach ;
    :hasTarget :Markarth ; :hasEvidence :Forsworn_Uprising_History ;
    :hasSource :Forsworn_Faction ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:The_Forsworn_Conspiracy"^^xsd:anyURI ;
    :contradicts :CLM_B007 ;
    :relatesTo :Markarth ; :relatesTo :Dwemer .

:CLM_B007 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "The Forsworn are criminals, not freedom fighters" ;
    :hasID "CLM-B007" ; :hasClaimType "Political Counter-Claim" ;
    :hasClaimTypeIRI :PoliticalCounterClaim ;
    :hasDescription "The Reach is legitimate Nord and Imperial territory; the Forsworn are dangerous criminals, not a legitimate resistance movement." ;
    :hasEvidenceStrength "0.40"^^xsd:decimal ;
    :hasClaimHolder :General_Tullius ;
    :hasTarget :Markarth ;
    :hasSource :Imperial_Legion ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Markarth"^^xsd:anyURI ;
    :contradicts :CLM_A007 ;
    :relatesTo :Markarth ; :relatesTo :Dwemer .

:CLM_A008 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Vampires deserve dominion — eternal night is liberation" ;
    :hasID "CLM-A008" ; :hasClaimType "Supremacist Claim" ;
    :hasClaimTypeIRI :SupremacistClaim ;
    :hasDescription "Vampires are the apex predators of Tamriel; blotting out the sun would free vampire-kind and establish their rightful dominion over mortals." ;
    :hasEvidenceStrength "0.30"^^xsd:decimal ;
    :hasClaimHolder :Harkon ;
    :hasTarget :Vampire ; :hasEvidence :Auriels_Bow ;
    :hasSource :Volkihar_Clan ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Lord_Harkon"^^xsd:anyURI ;
    :contradicts :CLM_B008 ;
    :relatesTo :Vampire .

:CLM_B008 rdf:type owl:NamedIndividual , :Claim ;
    rdfs:label "Vampirism is a curse — eternal night must be prevented" ;
    :hasID "CLM-B008" ; :hasClaimType "Moral Counter-Claim" ;
    :hasClaimTypeIRI :MoralCounterClaim ;
    :hasDescription "Vampirism is an abomination from Molag Bal's domination; the eternal night plan would destroy all mortal life and must be stopped." ;
    :hasEvidenceStrength "0.90"^^xsd:decimal ;
    :hasClaimHolder :Dragonborn ;
    :hasTarget :Vampire ; :hasEvidence :Auriels_Bow ;
    :hasSource :Dawnguard_Faction ;
    :sourceURL "https://en.uesp.net/wiki/Skyrim:Dawnguard_(faction)"^^xsd:anyURI ;
    :contradicts :CLM_A008 ;
    :relatesTo :Vampire .

